# Supabase project URL (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase service role key (server only)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional lower-privilege key for snapshot export if public reads are allowed
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Admin password for write access to CMS API routes
CMS_ADMIN_PASSWORD=MEIYOUmima007

# Optional table override (default: works)
SUPABASE_WORKS_TABLE=works

# Optional storage bucket for editor image uploads (default: works-media)
SUPABASE_STORAGE_BUCKET=works-media

# Optional Supabase REST timeouts
SUPABASE_REST_READ_TIMEOUT_MS=4000
SUPABASE_REST_WRITE_TIMEOUT_MS=15000
